# Also configurable in the local web UI. Never place this file in public/.
API_BASE_URL=https://your-provider.example/v1
API_KEY=
API_MODEL=
PORT=4317

# Required for a public deployment. Generate the hash with passwordHash()
# from lib/auth.mjs; never store the plaintext password here.
PUBLIC_ORIGIN=https://example.com
BASE_PATH=/intelligence
ADMIN_PASSWORD_HASH=
